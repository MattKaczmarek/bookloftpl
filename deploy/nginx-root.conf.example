# Przyklad produkcyjnego ukladu domeny bookloft.pl.
# Certbot zwykle dopisuje sciezki ssl_certificate, ssl_certificate_key,
# include options-ssl-nginx.conf i ssl_dhparam.

server {
    listen 443 ssl;
    http2 on;
    server_name www.bookloft.pl;

    return 301 https://bookloft.pl$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name bookloft.pl;

    location / {
        # The key is empty for static/API paths, so only SSR catalog pages are
        # accounted. Zone definitions: nginx-rate-limits.conf.example.
        limit_req zone=bookloft_shop_pages burst=20 nodelay;
        limit_conn bookloft_shop_connections 16;
        limit_req_status 429;
        limit_conn_status 429;

        proxy_pass http://127.0.0.1:3205;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name bookloft.pl www.bookloft.pl;
    return 301 https://bookloft.pl$request_uri;
}
