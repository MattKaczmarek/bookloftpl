[Unit]
Description=BookLoft shop
After=network.target
Documentation=file:///home/bookloftpl/docs/OPERATIONS.md

[Service]
Type=simple
# Dedicated service account — must NOT be the same UID as bookloft-asystent
# (bookloft). Shared UID would read Asystent ENV (root:bookloft 640) and
# keys under /home/bookloft/.ssh.
User=bookloft-shop
Group=bookloft-shop
WorkingDirectory=/home/bookloftpl
EnvironmentFile=/etc/bookloft-shop/bookloft-shop.env
# Prefer direct node over `npm start` so the service does not depend on npm
# writing caches under the service user.
ExecStart=/usr/bin/node /home/bookloftpl/src/server.js
Restart=always
RestartSec=5

# Least privilege: never root; isolate from Asystent/bots secrets and homes.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
# Runtime cache, OAuth tokens and storefront JSON live here only.
ReadWritePaths=/var/lib/bookloft-shop
# Code under /home/bookloftpl must stay world- or group-readable for this user;
# do not grant write there. Hide Asystent home, bot homes, and Asystent ENV dir.
InaccessiblePaths=/root /home/bookloft /home/bookloft-asystent /home/bot-andrzej /home/bot-jaroslaw /etc/bookloft-asystent
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
