# Wkleic do server block domen bookloft.pl i www.bookloft.pl.
# Glowna wizytowka pozostaje serwowana statycznie bez zmian.

location /test/ {
    proxy_pass http://127.0.0.1:3205/test/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /test {
    return 301 /test/;
}
